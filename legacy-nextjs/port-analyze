SERVER="ubuntu@140.245.7.141"
SSH_KEY="/home/bixpurr/n8n/ssh-key-2026-04-18.key"
LOCAL_PORT=3002
REMOTE_PORT=3002

echo -e "\033[1;36m▸ Starting secure tunnel to analytics dashboard...\033[0m"
echo -e "\033[1;32m✓ Tunnel established!\033[0m"
echo -e "\033[1;33m👉 Open your browser to: http://localhost:${LOCAL_PORT}\033[0m"
echo -e "\033[1;90m(Press Ctrl+C to close the connection when you're done)\033[0m"

